generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      String      @id @default(uuid())
  username                String      @unique
  passwordHash            String
  role                    String      @default("user")
  transcriptionLanguage   String      @default("ja")
  mcpClientId             String?     @unique
  mcpClientSecretHash     String?
  mcpCredentialsCreatedAt DateTime?
  mcpLastUsedAt           DateTime?
  recordings              Recording[]
  feedbacks               Feedback[]
  segments                Segment[]
  mobileTokens            MobileToken[]
  oauthAuthCodes          OAuthAuthCode[]
  oauthAccessTokens       OAuthAccessToken[]
  createdAt               DateTime    @default(now())
  updatedAt               DateTime    @updatedAt
}

model MobileToken {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique
  deviceLabel String?
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime?
  revokedAt   DateTime?

  @@index([userId])
}

model OAuthAuthCode {
  id                  String   @id @default(uuid())
  code                String   @unique
  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId            String
  redirectUri         String
  codeChallenge       String
  codeChallengeMethod String
  scope               String?
  expiresAt           DateTime
  consumedAt          DateTime?
  createdAt           DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model OAuthAccessToken {
  id           String    @id @default(uuid())
  tokenHash    String    @unique
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId     String
  scope        String?
  expiresAt    DateTime
  refreshHash  String?   @unique
  refreshExpAt DateTime?
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?

  @@index([userId])
  @@index([expiresAt])
}

model Recording {
  id                     String    @id @default(uuid())
  userId                 String
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  filename               String
  originalName           String
  displayName            String
  filePath               String
  fileSize               Int
  duration               Float     @default(0)
  mimeType               String    @default("audio/wav")
  transcriptionStatus    String    @default("pending")
  transcriptionText      String?
  transcriptionSegments  String?
  transcriptionError     String?
  transcriptionAt        DateTime?
  language               String?
  recordedAt             DateTime?
  whisperTranscribedAt   DateTime?
  whisperError           String?
  deletedByUser          Boolean   @default(false)
  deletedByUserAt        DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  meeting                Meeting?
  correctionResults      CorrectionResult[]
  groundTruths           GroundTruth[]
  evaluationResults      EvaluationResult[]
  feedbacks              Feedback[]
  segments               Segment[]

  @@unique([userId, originalName])
  @@index([userId, recordedAt])
}

model Segment {
  id           String    @id @default(uuid())
  recordingId  String
  recording    Recording @relation(fields: [recordingId], references: [id], onDelete: Cascade)
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  seq          Int
  startOffset  Float
  endOffset    Float
  startAt      DateTime
  endAt        DateTime
  text         String
  createdAt    DateTime  @default(now())

  @@index([userId, startAt])
  @@index([userId, endAt])
  @@index([recordingId, seq])
}

model Domain {
  id          String   @id @default(uuid())
  name        String   @unique
  description String
  entities          OntologyEntity[]
  meetings          Meeting[]
  snapshots         OntologySnapshot[]
  correctionResults CorrectionResult[]
  groundTruths      GroundTruth[]
  evaluationResults EvaluationResult[]
  feedbacks         Feedback[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Meeting {
  id           String    @id @default(uuid())
  domainId     String
  domain       Domain    @relation(fields: [domainId], references: [id])
  recordingId  String?   @unique
  recording    Recording? @relation(fields: [recordingId], references: [id])
  weekNumber   Int
  meetingDate  DateTime
  participants Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model OntologyEntity {
  id            String   @id @default(uuid())
  domainId      String
  domain        Domain   @relation(fields: [domainId], references: [id])
  prefLabel     String
  altLabels     String   @default("[]")
  phoneticHints String   @default("[]")
  definition    String?
  category      String?
  isActive      Boolean  @default(true)
  source        String   @default("manual")
  relationsFrom OntologyRelation[] @relation("fromEntity")
  relationsTo   OntologyRelation[] @relation("toEntity")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([domainId, prefLabel])
}

model OntologyRelation {
  id                 String         @id @default(uuid())
  fromEntityId       String
  fromEntity         OntologyEntity @relation("fromEntity", fields: [fromEntityId], references: [id], onDelete: Cascade)
  toEntityId         String
  toEntity           OntologyEntity @relation("toEntity", fields: [toEntityId], references: [id], onDelete: Cascade)
  relationType       String
  cooccurrenceWeight Float          @default(0)
  source             String         @default("manual")
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@unique([fromEntityId, toEntityId, relationType])
}

model OntologySnapshot {
  id            String   @id @default(uuid())
  domainId      String
  domain        Domain   @relation(fields: [domainId], references: [id])
  weekNumber    Int
  label         String?
  data          String
  entityCount   Int
  relationCount Int
  createdAt     DateTime @default(now())

  @@unique([domainId, weekNumber])
}

model CorrectionResult {
  id            String    @id @default(uuid())
  recordingId   String
  recording     Recording @relation(fields: [recordingId], references: [id], onDelete: Cascade)
  domainId      String
  domain        Domain    @relation(fields: [domainId], references: [id])
  condition     String    // "B1", "B2", "B3", "proposed", "A1", "A2", "A3", "A4", "A5"
  layer1Result  String?   // JSON: Layer1Result[]
  layer2Result  String?   // JSON: Layer2のフル結果（Phase 2Cで使用）
  correctedText String?   // 最終訂正テキスト
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([recordingId, domainId, condition])
}

model GroundTruth {
  id          String    @id @default(uuid())
  recordingId String
  recording   Recording @relation(fields: [recordingId], references: [id], onDelete: Cascade)
  domainId    String
  domain      Domain    @relation(fields: [domainId], references: [id])
  segments    String    // JSON: GT付きセグメント配列
  annotatorId String    // "annotator1", "annotator2"
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([recordingId, domainId, annotatorId])
}

model Feedback {
  id               String    @id @default(uuid())
  recordingId      String
  recording        Recording @relation(fields: [recordingId], references: [id], onDelete: Cascade)
  domainId         String
  domain           Domain    @relation(fields: [domainId], references: [id])
  userId           String
  user             User      @relation(fields: [userId], references: [id])
  segmentIndex     Int
  feedbackType     String    // "approve", "reject", "suggest_term", "suggest_correction"
  originalText     String
  correctedText    String?   // 訂正テキスト（reject/suggest_correctionの場合）
  suggestedTerm    String?   // 新用語提案
  suggestedReading String?   // 読み仮名提案
  comment          String?   // 自由コメント
  createdAt        DateTime  @default(now())
}

model EvaluationResult {
  id          String    @id @default(uuid())
  recordingId String
  recording   Recording @relation(fields: [recordingId], references: [id], onDelete: Cascade)
  domainId    String
  domain      Domain    @relation(fields: [domainId], references: [id])
  condition   String
  annotatorId String
  cerDE       Float
  cerGEN      Float
  cerTotal    Float
  dkdpRatio   Float
  entityCount Int
  details     String    // JSON: 詳細結果
  createdAt   DateTime  @default(now())

  @@unique([recordingId, domainId, condition, annotatorId])
}
